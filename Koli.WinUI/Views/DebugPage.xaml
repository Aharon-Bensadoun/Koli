<Page
    x:Class="Koli.WinUI.Views.DebugPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Koli.WinUI.Controls"
    xmlns:services="using:Koli.Services">

    <controls:PageShell Eyebrow="DEVELOPER"
                        Title="Debug console"
                        Subtitle="Live application log and retained capture audio for replay">
        <controls:PageShell.HeaderActions>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ClearCommand}" ToolTipService.ToolTip="Clear">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                        <TextBlock Text="Clear"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CopyCommand}" ToolTipService.ToolTip="Copy log to clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="13"/>
                        <TextBlock Text="Copy"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="13" Foreground="White"/>
                        <TextBlock Text="Export"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PageShell.HeaderActions>

        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Retained debug recordings -->
            <StackPanel Spacing="{StaticResource SpacingM}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="DEBUG RECORDINGS"
                                   Style="{StaticResource EyebrowLabelStyle}"
                                   Foreground="{StaticResource AuroraGlowBrush}"/>
                        <Border Width="20" Height="2" CornerRadius="1"
                                Background="{StaticResource EyebrowUnderlineBrush}"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="ClearAudio_Click"
                            Visibility="{Binding HasAudioEntries, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTipService.ToolTip="Clear all debug recordings">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{StaticResource ErrorBrush}"/>
                            <TextBlock Text="Clear recordings" Foreground="{StaticResource ErrorBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Title="Replay captures locally"
                         Message="Enable Keep debug audio in Settings to save each recording as WAV for listening here."
                         Visibility="{Binding KeepDebugAudioEnabled, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                <InfoBar IsOpen="True"
                         IsClosable="False"
                         Severity="Success"
                         Title="Debug audio retention is on"
                         Message="New captures are saved automatically. Oldest files are removed when the retention limit is reached."
                         Visibility="{Binding KeepDebugAudioEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <ItemsControl ItemsSource="{Binding AudioEntries}"
                              Visibility="{Binding HasAudioEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:DebugAudioEntry">
                            <Grid Margin="0,0,0,10" ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource AuroraGlowBrush}"
                                        CornerRadius="2,0,0,2"/>
                                <Border Grid.Column="1"
                                        Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource StrokeSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="0,16,16,0"
                                        Padding="20,16">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8D6;"
                                                  FontSize="20"
                                                  Foreground="{StaticResource AuroraGlowBrush}"
                                                  VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Kind}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                                                <TextBlock Text="·" Foreground="{ThemeResource TextTertiaryBrush}"/>
                                                <TextBlock Text="{x:Bind CapturedAt}"
                                                           Foreground="{ThemeResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind DurationLabel}"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           FontSize="12"/>
                                                <TextBlock Text="·" Foreground="{ThemeResource TextTertiaryBrush}" FontSize="12"/>
                                                <TextBlock Text="{x:Bind Language}"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <Button Click="AudioPlay_Click" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Play / Stop"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Padding="8">
                                                <FontIcon Glyph="&#xE768;" FontSize="13"/>
                                            </Button>
                                            <Button Click="AudioDelete_Click" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Delete"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Padding="8">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13"
                                                          Foreground="{StaticResource ErrorBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Log console -->
            <Border Grid.Row="1"
                    Background="{ThemeResource VoidBrush}"
                    BorderBrush="{ThemeResource StrokeSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLarge}"
                    Padding="2"
                    MinHeight="220">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Padding="14,10" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="10" Height="10" Fill="{StaticResource RecordingPrimaryBrush}"/>
                        <Ellipse Grid.Column="1" Width="10" Height="10" Fill="{StaticResource WarningBrush}"/>
                        <Ellipse Grid.Column="2" Width="10" Height="10" Fill="{StaticResource SuccessBrush}"/>
                        <TextBlock Grid.Column="4"
                                   Text="koli ~ debug.log"
                                   Style="{StaticResource MonoLabelStyle}"
                                   Opacity="0.7"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <controls:AuroraDivider Grid.Row="0" VerticalAlignment="Bottom"/>

                    <TextBox Grid.Row="1"
                             Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="16"/>
                </Grid>
            </Border>
        </Grid>
    </controls:PageShell>
</Page>
