<Page
    x:Class="Koli.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Koli.WinUI.Controls"
    xmlns:config="using:Koli.Config"
    xmlns:cc="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <!-- Section row : eyebrow label + aurora underline -->
        <Style x:Key="SectionEyebrowStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Page.Resources>

    <controls:PageShell Eyebrow="SETTINGS"
                        Title="Tune Koli to your workflow"
                        Subtitle="Languages, rewriting, voice assistant, and typing">
        <controls:PageShell.HeaderActions>
            <Button Content="Save"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}"/>
        </controls:PageShell.HeaderActions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="{StaticResource SpacingXXL}"
                        MaxWidth="{StaticResource PageContentReadableWidth}"
                        HorizontalAlignment="Stretch">

                <!-- Account & API -->
                <StackPanel Spacing="{StaticResource SpacingM}">
                    <StackPanel Style="{StaticResource SectionEyebrowStyle}">
                        <TextBlock Text="ACCOUNT" Style="{StaticResource EyebrowLabelStyle}"
                                   Foreground="{StaticResource AuroraGlowBrush}"/>
                        <Border Width="20" Height="2" CornerRadius="1"
                                Background="{StaticResource EyebrowUnderlineBrush}"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                    <cc:SettingsCard Header="API configuration"
                                     Description="Connect Koli to OpenAI, Azure OpenAI, or an on-premise endpoint."
                                     IsClickEnabled="True"
                                     Command="{Binding ConfigureApiCommand}">
                        <cc:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE192;"/>
                        </cc:SettingsCard.HeaderIcon>
                    </cc:SettingsCard>
                </StackPanel>

                <!-- Languages -->
                <StackPanel Spacing="{StaticResource SpacingM}">
                    <StackPanel Style="{StaticResource SectionEyebrowStyle}">
                        <TextBlock Text="LANGUAGES &amp; TRANSLATION" Style="{StaticResource EyebrowLabelStyle}"
                                   Foreground="{StaticResource AuroraGlowBrush}"/>
                        <Border Width="20" Height="2" CornerRadius="1"
                                Background="{StaticResource EyebrowUnderlineBrush}"
                                VerticalAlignment="Center"/>
                    </StackPanel>

                    <cc:SettingsExpander Header="Output language"
                                         Description="Force the transcription language or follow the spoken one."
                                         IsExpanded="True"
                                         IsEnabled="{Binding IsOutputLanguageAvailable, Mode=OneWay}">
                        <cc:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xF2B7;"/>
                        </cc:SettingsExpander.HeaderIcon>
                        <cc:SettingsExpander.Items>
                            <cc:SettingsCard Header="Mode">
                                <ComboBox MinWidth="220"
                                          ItemsSource="{Binding OutputLanguageModes}"
                                          SelectedItem="{Binding SelectedOutputLanguageMode, Mode=TwoWay}"
                                          IsEnabled="{Binding IsOutputLanguageAvailable, Mode=OneWay}"/>
                            </cc:SettingsCard>
                            <cc:SettingsCard Header="Target language"
                                             Description="Used when mode is set to a fixed language.">
                                <ComboBox MinWidth="220"
                                          ItemsSource="{Binding TargetLanguageOptions}"
                                          SelectedItem="{Binding SelectedTargetLanguage, Mode=TwoWay}"
                                          IsEnabled="{Binding IsTargetLanguageEnabled, Mode=OneWay}"/>
                            </cc:SettingsCard>
                        </cc:SettingsExpander.Items>
                    </cc:SettingsExpander>
                </StackPanel>

                <!-- Rewriting -->
                <StackPanel Spacing="{StaticResource SpacingM}">
                    <StackPanel Style="{StaticResource SectionEyebrowStyle}">
                        <TextBlock Text="TEXT REWRITING" Style="{StaticResource EyebrowLabelStyle}"
                                   Foreground="{StaticResource AuroraGlowBrush}"/>
                        <Border Width="20" Height="2" CornerRadius="1"
                                Background="{StaticResource EyebrowUnderlineBrush}"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                    <cc:SettingsExpander Header="Rewrite captured text"
                                         Description="Polish what you dictate before it is typed.">
                        <cc:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE932;"/>
                        </cc:SettingsExpander.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding RewriteEnabled, Mode=TwoWay}"/>
                        <cc:SettingsExpander.Items>
                            <cc:SettingsCard Header="Style"
                                             Description="How strongly Koli rewrites your dictation.">
                                <ComboBox MinWidth="220"
                                          ItemsSource="{Binding RewriteLevels}"
                                          SelectedItem="{Binding RewriteLevel, Mode=TwoWay}"
                                          IsEnabled="{Binding RewriteEnabled, Mode=OneWay}"/>
                            </cc:SettingsCard>
                        </cc:SettingsExpander.Items>
                    </cc:SettingsExpander>
                </StackPanel>

                <!-- Voice assistant -->
                <StackPanel Spacing="{StaticResource SpacingM}">
                    <StackPanel Style="{StaticResource SectionEyebrowStyle}">
                        <TextBlock Text="VOICE ASSISTANT (Alt Gr)" Style="{StaticResource EyebrowLabelStyle}"
                                   Foreground="{StaticResource AuroraGlowBrush}"/>
                        <Border Width="20" Height="2" CornerRadius="1"
                                Background="{StaticResource EyebrowUnderlineBrush}"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                    <cc:SettingsExpander Header="Voice assistant"
                                         Description="Ask a spoken question with Alt Gr; Koli types the answer into the active window.">
                        <cc:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE99A;"/>
                        </cc:SettingsExpander.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding AssistantEnabled, Mode=TwoWay}"/>
                        <cc:SettingsExpander.Items>
                            <cc:SettingsCard Header="Web search"
                                             Description="Allow the assistant to perform a web search before answering.">
                                <ToggleSwitch IsOn="{Binding AssistantWebSearchEnabled, Mode=TwoWay}"
                                              IsEnabled="{Binding AssistantEnabled, Mode=OneWay}"/>
                            </cc:SettingsCard>
                            <cc:SettingsCard Header="Model"
                                             Description="Override the default assistant model.">
                                <TextBox MinWidth="220"
                                         Text="{Binding AssistantModel, Mode=TwoWay}"
                                         PlaceholderText="gpt-4.1"
                                         IsEnabled="{Binding AssistantEnabled, Mode=OneWay}"/>
                            </cc:SettingsCard>
                        </cc:SettingsExpander.Items>
                    </cc:SettingsExpander>
                </StackPanel>

                <!-- Custom prompt actions -->
                <StackPanel Spacing="{StaticResource SpacingM}">
                    <StackPanel Style="{StaticResource SectionEyebrowStyle}">
                        <TextBlock Text="CUSTOM PROMPT ACTIONS" Style="{StaticResource EyebrowLabelStyle}"
                                   Foreground="{StaticResource AuroraGlowBrush}"/>
                        <Border Width="20" Height="2" CornerRadius="1"
                                Background="{StaticResource EyebrowUnderlineBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <cc:SettingsExpander Header="Voice transformations"
                                         Description="Transcribe, then process the result with a profile-specific prompt and shortcut.">
                        <cc:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE945;"/>
                        </cc:SettingsExpander.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding CustomActionsEnabled, Mode=TwoWay}"/>
                        <cc:SettingsExpander.Items>
                            <cc:SettingsCard Header="Default OpenAI model">
                                <TextBox MinWidth="220" Text="{Binding CustomActionsDefaultModel, Mode=TwoWay}" PlaceholderText="gpt-4.1"/>
                            </cc:SettingsCard>
                            <cc:SettingsCard Header="Default AI Nexus provider ID" Description="Optional; profiles can override it.">
                                <TextBox MinWidth="220" Text="{Binding CustomActionsDefaultProviderId, Mode=TwoWay}"/>
                            </cc:SettingsCard>
                            <cc:SettingsCard Header="Profiles" Description="Each enabled profile registers one global shortcut.">
                                <StackPanel Spacing="10" MinWidth="420">
                                    <Button Click="AddCustomAction_Click" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                            <TextBlock Text="Add profile"/>
                                        </StackPanel>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding CustomActionProfiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="config:CustomActionProfile">
                                                <Grid Padding="0,8" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind Hotkey}" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Click="EditCustomAction_Click" Tag="{x:Bind}"
                                                            Style="{StaticResource GhostButtonStyle}" ToolTipService.ToolTip="Edit">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="13"/>
                                                    </Button>
                                                    <Button Grid.Column="2" Click="DeleteCustomAction_Click" Tag="{x:Bind}"
                                                            Style="{StaticResource GhostButtonStyle}" ToolTipService.ToolTip="Delete">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{StaticResource ErrorBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </cc:SettingsCard>
                        </cc:SettingsExpander.Items>
                    </cc:SettingsExpander>
                </StackPanel>

                <!-- Typing -->
                <StackPanel Spacing="{StaticResource SpacingM}">
                    <StackPanel Style="{StaticResource SectionEyebrowStyle}">
                        <TextBlock Text="TYPING" Style="{StaticResource EyebrowLabelStyle}"
                                   Foreground="{StaticResource AuroraGlowBrush}"/>
                        <Border Width="20" Height="2" CornerRadius="1"
                                Background="{StaticResource EyebrowUnderlineBrush}"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                    <cc:SettingsCard Header="Auto space"
                                     Description="Insert a space before typed text when needed.">
                        <cc:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE75D;"/>
                        </cc:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding TypingAutoSpace, Mode=TwoWay}"/>
                    </cc:SettingsCard>
                    <cc:SettingsCard Header="Type in active window"
                                     Description="Send the transcribed text directly to the focused window.">
                        <cc:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7C5;"/>
                        </cc:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding TypingInActiveWindow, Mode=TwoWay}"/>
                    </cc:SettingsCard>
                    <cc:SettingsCard Header="Streaming mode"
                                     Description="Type partial results as they arrive.">
                        <cc:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE9D9;"/>
                        </cc:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding TypingStreamingMode, Mode=TwoWay}"/>
                    </cc:SettingsCard>
                </StackPanel>

                <!-- Developer / debug -->
                <StackPanel Spacing="{StaticResource SpacingM}">
                    <StackPanel Style="{StaticResource SectionEyebrowStyle}">
                        <TextBlock Text="DEVELOPER" Style="{StaticResource EyebrowLabelStyle}"
                                   Foreground="{StaticResource AuroraGlowBrush}"/>
                        <Border Width="20" Height="2" CornerRadius="1"
                                Background="{StaticResource EyebrowUnderlineBrush}"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                    <cc:SettingsCard Header="Keep debug audio"
                                     Description="Save each capture as WAV so you can replay it on the Debug page. Oldest files are removed after the retention limit.">
                        <cc:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8D6;"/>
                        </cc:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding KeepDebugAudio, Mode=TwoWay}"/>
                    </cc:SettingsCard>
                </StackPanel>

                <!-- System -->
                <StackPanel Spacing="{StaticResource SpacingM}"
                            Visibility="{Binding IsLaunchAtStartupAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Style="{StaticResource SectionEyebrowStyle}">
                        <TextBlock Text="SYSTEM" Style="{StaticResource EyebrowLabelStyle}"
                                   Foreground="{StaticResource AuroraGlowBrush}"/>
                        <Border Width="20" Height="2" CornerRadius="1"
                                Background="{StaticResource EyebrowUnderlineBrush}"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                    <cc:SettingsCard Header="Launch at Windows sign-in"
                                     Description="Also configurable in Settings → Apps → Startup apps.">
                        <cc:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7E8;"/>
                        </cc:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding LaunchAtStartup, Mode=TwoWay}"/>
                    </cc:SettingsCard>
                </StackPanel>

                <!-- About -->
                <StackPanel Spacing="{StaticResource SpacingM}">
                    <StackPanel Style="{StaticResource SectionEyebrowStyle}">
                        <TextBlock Text="ABOUT" Style="{StaticResource EyebrowLabelStyle}"
                                   Foreground="{StaticResource AuroraGlowBrush}"/>
                        <Border Width="20" Height="2" CornerRadius="1"
                                Background="{StaticResource EyebrowUnderlineBrush}"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42"
                                    CornerRadius="12"
                                    Background="{StaticResource AuroraDiagonalBrush}">
                                <FontIcon Glyph="&#xE946;" FontSize="20" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Koli"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding AboutSummary}"
                                           TextWrapping="WrapWholeWords"
                                           Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding AboutDeveloper}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <HyperlinkButton Content="{Binding ContactEmail}"
                                                 NavigateUri="{Binding ContactMailtoUri}"
                                                 Padding="0"
                                                 HorizontalAlignment="Left"/>
                                <HyperlinkButton Content="{Binding RepositoryUrl}"
                                                 NavigateUri="{Binding RepositoryUri}"
                                                 Padding="0"
                                                 HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding AboutCopyright}"
                                           TextWrapping="WrapWholeWords"
                                           Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </controls:PageShell>
</Page>
